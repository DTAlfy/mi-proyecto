# --- Privacidad: datos de alumnos (se quedan solo en tu PC) ---
60_Estudiantes/Alumnos/*
60_Estudiantes/Sesiones/*
60_Estudiantes/Evaluaciones/*
60_Estudiantes/Arboles/*
!60_Estudiantes/*/.gitkeep
# Excepción: alumnos ficticios de demostración (nombre con "Demo")
!60_Estudiantes/*/*Demo*

# --- Fuentes: el material bruto (libros convertidos, PDFs, capturas, Sheets) se queda en tu PC ---
# Solo se suben las fichas de fuente (metadatos tuyos) y la guía de la carpeta.
10_Fuentes/*
!10_Fuentes/_LEEME.md
!10_Fuentes/Fichas/

# --- Copyright y archivos pesados ---
*.pdf
*.epub
*.mobi
*.docx
*.pptx
*.mp3
*.mp4
*.m4a
*.mov
10_Fuentes/**/*.png
10_Fuentes/**/*.jpg
10_Fuentes/**/*.jpeg

# --- Exportaciones ---
*.tsv

# --- Obsidian: estado local de la ventana ---
.obsidian/workspace*.json
.obsidian/cache
.trash/

# --- Sistema ---
.DS_Store
Thumbs.db
__pycache__/
