filters:
  and:
    - 'tipo == "alumno"'
views:
  - type: table
    name: Activos
    filters:
      or:
        - 'estado == "activo"'
        - 'estado == "prueba"'
    order:
      - file.name
      - nivel_base
      - meta
      - objetivo
      - frecuencia
      - proxima_evaluacion
  - type: table
    name: Por nivel
    groupBy:
      property: nivel_base
      direction: ASC
    order:
      - file.name
      - estado
      - meta
  - type: table
    name: Antiguos y en pausa
    filters:
      or:
        - 'estado == "pausa"'
        - 'estado == "antiguo"'
    order:
      - file.name
      - estado
      - nivel_base
      - objetivo
  - type: cards
    name: Tarjetas
    order:
      - file.name
      - estado
      - meta
